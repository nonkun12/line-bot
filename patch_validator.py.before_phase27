import ast
import re


def validate_python_code(code):

    try:
        ast.parse(code)
        return {
            "ok": True,
            "message": "Python syntax OK"
        }

    except SyntaxError as e:
        return {
            "ok": False,
            "message": f"Syntax Error: {e}"
        }


def validate_patch_scope(patch, target_function=None):
    """
    unified diff内の変更範囲を確認する
    """
    if not patch:
        return {
            "ok": False,
            "message": "パッチが空です"
        }

    # 1. import変更チェック
    for line in patch.splitlines():
        if (
            line.startswith("+import ") or line.startswith("+from ") or
            line.startswith("-import ") or line.startswith("-from ") or
            line.startswith("+import\t") or line.startswith("-import\t")
        ):
            return {
                "ok": False,
                "message": "⚠️ import変更あり"
            }

    # 2. 変更行数チェック
    removed = len(re.findall(r"^-", patch, re.MULTILINE))
    added = len(re.findall(r"^\+", patch, re.MULTILINE))
    total_changed = removed + added
    if total_changed > 30:
        return {
            "ok": False,
            "message": "⚠️ 変更範囲超過"
        }

    # 3. 対象関数変更チェック
    if target_function:
        changed_funcs = re.findall(r"^\+\s*def\s+([a-zA-Z_][a-zA-Z0-9_]*)", patch, re.MULTILINE)
        for func in changed_funcs:
            if func != target_function:
                return {
                    "ok": False,
                    "message": f"⚠️ 対象外関数変更: {func}"
                }

    return {
        "ok": True,
        "message": "Patch scope OK"
    }


def review_patch(patch, target_function=None):

    result = []

    result.append("🔎 Patch Validator")

    # Scope検証
    scope_check = validate_patch_scope(patch, target_function=target_function)
    if not scope_check["ok"]:
        result.append(scope_check["message"])
        result.append("自動適用禁止")

    # diff形式チェック
    if not patch.startswith("--- "):
        result.append(
            "❌ diff形式ではありません"
        )
        result.append(
            "自動適用禁止"
        )
        return "\n".join(result)

    result.append(
        "✅ diff形式を検出"
    )

    # Markdown混入チェック
    if "```" in patch:
        result.append(
            "⚠️ Markdownコードブロック混入"
        )
        result.append(
            "自動適用禁止"
        )

    # 対象ファイルチェック
    if "set_reminder.py" in patch:
        result.append(
            "⚠️ 対象外ファイル変更"
        )
        result.append(
            "自動適用禁止"
        )


    # 変更ファイル数チェック(1ファイルのみ許可)
    changed_files = re.findall(r"^\\+\\+\\+ (.+)$", patch, re.MULTILINE)

    if len(changed_files) > 1:
        result.append(
            "⚠️ 変更ファイルが複数あります(1ファイルのみ許可)"
        )
        result.append(
            "自動適用禁止"
        )


    # 危険ファイル変更禁止チェック
    dangerous_files = [
        "config.py",
        "mcp_client.py",
        ".env"
    ]

    for danger_file in dangerous_files:
        if danger_file in patch:
            result.append(
                f"⚠️ 危険ファイル変更検出: {danger_file}"
            )
            result.append(
                "自動適用禁止"
            )


    # 削除・追加行数確認
    removed = len(
        re.findall(r"^-", patch, re.MULTILINE)
    )

    added = len(
        re.findall(r"^\+", patch, re.MULTILINE)
    )

    result.append(
        f"削除行数: {removed}"
    )

    result.append(
        f"追加行数: {added}"
    )


    # 変更行数チェック(追加+削除 合計30行以内)
    total_changed = removed + added

    if total_changed > 30:
        result.append(
            f"⚠️ 変更行数が上限を超えています(合計{total_changed}行 / 上限30行)"
        )
        result.append(
            "⚠️ 変更行数超過"
        )
        result.append(
            "自動適用禁止"
        )

    # import変更検出
    for line in patch.splitlines():
        if (
            line.startswith("+import ") or line.startswith("+from ") or
            line.startswith("-import ") or line.startswith("-from ") or
            line.startswith("+import\t") or line.startswith("-import\t")
        ):
            result.append(
                "⚠️ import変更あり"
            )
            result.append(
                "自動適用禁止"
            )
            break


    # 大量削除防止
    if removed > 100:
        result.append(
            "⚠️ 大量削除を検出"
        )
        result.append(
            "自動適用禁止"
        )


    # 危険変更
    if "except Exception" in patch:
        result.append(
            "⚠️ except Exception変更あり"
        )

    if "os.remove" in patch:
        result.append(
            "⚠️ ファイル削除処理あり"
        )

    if "subprocess" in patch:
        result.append(
            "⚠️ subprocess変更あり"
        )


    if removed <= 100 and scope_check["ok"]:
        result.append(
            "✅ 基本安全チェック通過"
        )


    return "\n".join(result)

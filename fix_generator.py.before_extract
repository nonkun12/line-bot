import re
import difflib
from datetime import datetime


def clean_code_block(text):
    """
    LLM出力からMarkdown記法や説明文を除去し、Pythonコードのみを抽出する
    """
    if not text:
        return ""

    # ```python ... ``` または ``` ... ``` コードブロックを抽出
    pattern = r"```(?:python|diff)?\s*\n?(.*?)\s*```"
    match = re.search(pattern, text, re.DOTALL)
    if match:
        return match.group(1).strip()

    # コードフェンス記号を除去
    cleaned = re.sub(r"^```.*$", "", text, flags=re.MULTILINE).strip()
    return cleaned


def generate_patch(original_code, fixed_code, filename="app.py"):
    """
    AI修正案をdiff形式で生成する
    """

    cleaned_fixed = clean_code_block(fixed_code)

    orig_lines = original_code.splitlines()
    fixed_lines = cleaned_fixed.splitlines()

    diff_lines = list(difflib.unified_diff(
        orig_lines,
        fixed_lines,
        fromfile=filename,
        tofile=filename + ".fixed",
        lineterm=""
    ))

    # 変更行数の確認（--- や +++ ヘッダーを除く）
    removed = sum(1 for line in diff_lines if line.startswith("-") and not line.startswith("--- "))
    added = sum(1 for line in diff_lines if line.startswith("+") and not line.startswith("+++ "))
    total_changed = removed + added

    if total_changed >= 100:
        return f"⚠️ 警告: 変更行数が大きすぎます (削除{removed}行 + 追加{added}行 = {total_changed}行 / 上限100行)。巨大diff生成を中止しました。"

    patch = "\n".join(diff_lines)

    return f"""
🛠️ Fix Generator

Patch generated

File:
{filename}

Created:
{datetime.now()}

--- PATCH START ---

{patch}

--- PATCH END ---
"""


def create_backup(filename):

    import os

    if not os.path.exists(filename):
        return "バックアップ対象なし"

    backup = filename + ".backup"

    with open(filename, "r", encoding="utf-8") as src:
        data = src.read()

    with open(backup, "w", encoding="utf-8") as dst:
        dst.write(data)

    return f"バックアップ作成: {backup}"
